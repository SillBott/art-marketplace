<file path="templates/artwork_detail.html">
{% extends "base.html" %}
{% from "_formhelpers.html" import render_field %}
{% block title %}{{ artwork.title }} - Art Marketplace{% endblock %}
{% block content %}

<div class="row g-4">
  <div class="col-md-6">
    {% if artwork.preview_filename %}
    <img src="{{ artwork.preview_filename | art_url }}" class="detail-img" alt="{{ artwork.title }}">
    {% else %}
    <img src="https://placehold.co/500x400?text=No+Image" class="detail-img">
    {% endif %}
  </div>
  <div class="col-md-6">
    <h2>{{ artwork.title }}</h2>
    <p class="text-muted">
      โดย <a href="{{ url_for('gallery.artist_public_profile', artist_id=artwork.artist.id) }}">{{ artwork.artist.display_name }}</a>
      {% if artwork.artist.school %} · {{ artwork.artist.school }}{% endif %}
    </p>
    <p><span class="badge bg-secondary">{{ artwork.category.name }}</span></p>
    <p>{{ artwork.description or "ไม่มีคำอธิบาย" }}</p>
    <ul class="list-unstyled">
      <li><strong>เทคนิค:</strong> {{ artwork.technique or "-" }}</li>
      <li><strong>ขนาด:</strong> {{ artwork.size_display }}</li>
      <li><strong>สถานะ:</strong>
        {% if artwork.status == 'available' %}
          <span class="text-success">พร้อมจำหน่าย</span>
        {% else %}
          <span class="text-danger">ขายแล้ว</span>
        {% endif %}
      </li>
      <li>
        <strong>คะแนนรีวิว:</strong>
        {% if avg_rating %}
          {{ "%.1f"|format(avg_rating) }} / 5 ({{ reviews|length }} รีวิว)
        {% else %}
          ยังไม่มีรีวิว
        {% endif %}
      </li>
    </ul>
    <h3 class="text-primary">฿{{ "%.2f"|format(artwork.price) }}</h3>

    <div class="d-flex gap-2 mb-3">
      {% if artwork.status == 'available' %}
      <form method="post" action="{{ url_for('cart.add', artwork_id=artwork.id) }}">
        <button class="btn btn-primary btn-lg">เพิ่มลงตะกร้า</button>
      </form>
      {% else %}
      <button class="btn btn-secondary btn-lg" disabled>ขายแล้ว</button>
      {% endif %}

      {% if current_user.is_authenticated %}
      <form method="post" action="{{ url_for('gallery.like', artwork_id=artwork.id) }}">
        <button class="btn btn-outline-danger btn-lg">
          {% if user_has_liked %}♥{% else %}♡{% endif %} {{ like_count }}
        </button>
      </form>
      {% else %}
      <span class="btn btn-outline-danger btn-lg disabled">♡ {{ like_count }}</span>
      {% endif %}
    </div>
  </div>
</div>

<hr class="my-4">
<h4>รีวิวจากผู้ซื้อ</h4>

{% if current_user.is_authenticated %}
<div class="card mb-4" style="max-width: 500px;">
  <div class="card-body">
    <h6 class="card-title">{{ "แก้ไขรีวิวของคุณ" if user_review else "ให้คะแนนผลงานนี้" }}</h6>
    <form method="post" action="{{ url_for('gallery.review', artwork_id=artwork.id) }}" novalidate>
      {{ review_form.hidden_tag() }}
      {{ render_field(review_form.rating) }}
      {{ render_field(review_form.comment) }}
      {{ render_field(review_form.submit) }}
    </form>
  </div>
</div>
{% else %}
<p class="text-muted"><a href="{{ url_for('auth.login') }}">เข้าสู่ระบบ</a> เพื่อเขียนรีวิว</p>
{% endif %}

{% if reviews %}
<div class="list-group mb-4" style="max-width: 600px;">
  {% for r in reviews %}
  <div class="list-group-item">
    <div class="d-flex justify-content-between">
      <strong>{{ r.user.username }}</strong>
      <span class="text-warning">{{ "★" * r.rating }}{{ "☆" * (5 - r.rating) }}</span>
    </div>
    {% if r.comment %}<p class="mb-0 mt-1">{{ r.comment }}</p>{% endif %}
    <small class="text-muted">{{ r.created_at.strftime("%d/%m/%Y") }}</small>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="text-muted">ยังไม่มีรีวิวสำหรับผลงานนี้</p>
{% endif %}

{% if related %}
<h4 class="mt-5">ผลงานที่คล้ายกัน</h4>
<div class="row row-cols-2 row-cols-md-4 g-3">
  {% for r in related %}
  <div class="col">
    <div class="card art-card h-100">
      {% if r.preview_filename %}
      <img src="{{ r.preview_filename | art_url }}" alt="{{ r.title }}">
      {% endif %}
      <div class="card-body">
        <h6 class="card-title">{{ r.title }}</h6>
        <a href="{{ url_for('gallery.detail', artwork_id=r.id) }}" class="btn btn-sm btn-outline-primary w-100">ดู</a>
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

{% endblock %}
</file>

<file path="templates/base.html">
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Art Marketplace{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="{{ url_for('static', filename='css/style.css') }}" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="{{ url_for('gallery.index') }}">🎨 Art Marketplace</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="{{ url_for('gallery.index') }}">แกลเลอรี</a></li>
          {% if current_user.is_authenticated and current_user.artist_profile %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('artist.my_artworks') }}">ผลงานของฉัน</a></li>
          {% endif %}
          {% if current_user.is_authenticated %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('orders.my_orders') }}">คำสั่งซื้อของฉัน</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('orders.collection') }}">คอลเล็คชั่นของฉัน</a></li>
          {% endif %}
          {% if current_user.is_authenticated and current_user.is_staff %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('admin.dashboard') }}">แผงควบคุมแอดมิน</a></li>
          {% endif %}
        </ul>
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="{{ url_for('cart.view') }}">🛒 ตะกร้า</a>
          </li>
          {% if current_user.is_authenticated %}
          <li class="nav-item"><span class="nav-link text-light">สวัสดี, {{ current_user.username }}</span></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.account') }}">บัญชีของฉัน</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.logout') }}">ออกจากระบบ</a></li>
          {% else %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.login') }}">เข้าสู่ระบบ</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.register') }}">สมัครสมาชิก</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <div class="container pb-5">
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        {% for category, message in messages %}
          <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
      {% endif %}
    {% endwith %}

    {% block content %}{% endblock %}
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="templates/cart.html">
{% extends "base.html" %}
{% block title %}ตะกร้าสินค้า{% endblock %}
{% block content %}
<h3 class="mb-4">ตะกร้าสินค้า</h3>

{% if items %}
<table class="table align-middle">
  <thead><tr><th>รูป</th><th>ชื่อผลงาน</th><th>ราคา</th><th></th></tr></thead>
  <tbody>
    {% for art in items %}
    <tr>
      <td style="width:80px">
        {% if art.preview_filename %}
        <img src="{{ art.preview_filename | art_url }}" width="60" height="60" style="object-fit:cover" class="rounded">
        {% endif %}
      </td>
      <td>{{ art.title }}</td>
      <td>฿{{ "%.2f"|format(art.price) }}</td>
      <td class="text-end">
        <form method="post" action="{{ url_for('cart.remove', artwork_id=art.id) }}">
          <button class="btn btn-sm btn-outline-danger">นำออก</button>
        </form>
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="d-flex justify-content-between align-items-center">
  <div>
    <h4 class="mb-0">รวมทั้งหมด: ฿{{ "%.2f"|format(total) }}</h4>
    <form method="post" action="{{ url_for('cart.clear') }}" class="d-inline">
      <button class="btn btn-sm btn-link text-muted p-0">ล้างตะกร้า</button>
    </form>
  </div>
  <a href="{{ url_for('orders.checkout') }}" class="btn btn-primary btn-lg">ดำเนินการชำระเงิน</a>
</div>
{% else %}
<p class="text-muted">ตะกร้าของคุณว่างเปล่า</p>
<a href="{{ url_for('gallery.index') }}" class="btn btn-primary">เลือกซื้อผลงาน</a>
{% endif %}
{% endblock %}
</file>

<file path="templates/checkout.html">
{% extends "base.html" %}
{% from "_formhelpers.html" import render_field %}
{% block title %}ชำระเงิน{% endblock %}
{% block content %}
<div class="row">
  <div class="col-md-6">
    <h3 class="mb-4">สรุปคำสั่งซื้อ</h3>
    <ul class="list-group mb-3">
      {% for art in items %}
      <li class="list-group-item d-flex justify-content-between">
        {{ art.title }} <span>฿{{ "%.2f"|format(art.price) }}</span>
      </li>
      {% endfor %}
      <li class="list-group-item d-flex justify-content-between fw-bold">
        รวมทั้งหมด <span>฿{{ "%.2f"|format(total) }}</span>
      </li>
    </ul>
    <div class="alert alert-info">
      โอนเงินผ่าน PromptPay QR แล้วแนบสลิปด้านขวาเพื่อยืนยันคำสั่งซื้อ
      <br><span class="text-muted">ชำระให้: {{ payment_info.label }}</span>
      {% if payment_info.qr_filename %}
      <div class="text-center my-2">
        <img src="{{ payment_info.qr_filename | settings_qr_url }}" width="200" class="rounded border bg-white p-2">
      </div>
      {% endif %}
      {% if payment_info.promptpay_id %}
      <br><strong>PromptPay:</strong> {{ payment_info.promptpay_id }}
      {% if payment_info.promptpay_name %} ({{ payment_info.promptpay_name }}){% endif %}
      {% else %}
      <br><span class="text-muted">ยังไม่ได้ตั้งค่าข้อมูลรับเงิน — ติดต่อแอดมิน</span>
      {% endif %}
    </div>
  </div>
  <div class="col-md-6">
    <h3 class="mb-4">แนบสลิปการโอนเงิน</h3>
    <form method="post" enctype="multipart/form-data" novalidate>
      {{ form.hidden_tag() }}
      {{ render_field(form.slip) }}
      {{ render_field(form.submit) }}
    </form>
  </div>
</div>
{% endblock %}
</file>

