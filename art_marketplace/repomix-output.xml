      <div class="text-muted small">ยอดขายรวม</div>
      <div class="fs-4 fw-bold">฿{{ "%.2f"|format(total_sales) }}</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">คำสั่งซื้อทั้งหมด</div>
      <div class="fs-4 fw-bold">{{ total_orders }}</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">รอตรวจสลิป</div>
      <div class="fs-4 fw-bold text-warning">{{ pending_payment }}</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">ผลงานรออนุมัติ</div>
      <div class="fs-4 fw-bold text-warning">
        <a href="{{ url_for('admin.pending_artworks') }}">{{ pending_approval }}</a>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-6">
    <h5>ศิลปินขายดี (แบ่งรายได้)</h5>
    <table class="table table-sm">
      <thead><tr><th>ศิลปิน</th><th>ขายได้</th><th>รายได้ศิลปิน</th><th>ค่าคอมมิชชั่นแพลตฟอร์ม</th></tr></thead>
      <tbody>
        {% for row in artist_rows %}
        <tr>
          <td>{{ row.name }}</td>
          <td>{{ row.sold_count }}</td>
          <td>฿{{ "%.2f"|format(row.artist_earnings) }}</td>
          <td>฿{{ "%.2f"|format(row.platform_fee) }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="text-muted">ยังไม่มีข้อมูลยอดขาย</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="col-md-6">
    <h5>คำสั่งซื้อล่าสุด</h5>
    <table class="table table-sm">
      <thead><tr><th>เลขที่</th><th>ลูกค้า</th><th>ยอด</th><th>สถานะ</th></tr></thead>
      <tbody>
        {% for order in recent_orders %}
        <tr>
          <td><a href="{{ url_for('orders.detail', order_id=order.id) }}">#{{ order.id }}</a></td>
          <td>{{ order.customer.username }}</td>
          <td>฿{{ "%.2f"|format(order.total_amount) }}</td>
          <td>{{ order.STATUS_LABELS.get(order.status, order.status) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="mt-4">
  <a href="{{ url_for('admin.orders') }}" class="btn btn-outline-primary">จัดการคำสั่งซื้อ</a>
  <a href="{{ url_for('admin.pending_artworks') }}" class="btn btn-outline-primary">อนุมัติผลงาน</a>
  <a href="{{ url_for('admin.categories') }}" class="btn btn-outline-primary">จัดการหมวดหมู่</a>
  {% if current_user.is_admin %}
  <a href="{{ url_for('admin.settings') }}" class="btn btn-outline-primary">ตั้งค่าการรับเงิน</a>
  <a href="{{ url_for('admin.users') }}" class="btn btn-outline-primary">จัดการผู้ใช้</a>
  <a href="{{ url_for('admin.logs') }}" class="btn btn-outline-secondary">Audit Log</a>
  {% endif %}
</div>
{% endblock %}
</file>

<file path="templates/admin_logs.html">
{% extends "base.html" %}
{% block title %}Audit Log{% endblock %}
{% block content %}
<h3 class="mb-4">Audit Log (ประวัติการแก้ไขข้อมูลสำคัญ)</h3>
<table class="table table-sm">
  <thead><tr><th>เวลา</th><th>ผู้ใช้</th><th>การกระทำ</th><th>ตาราง</th><th>รหัส</th><th>รายละเอียด</th></tr></thead>
  <tbody>
    {% for log in pagination.items %}
    <tr>
      <td>{{ log.timestamp.strftime("%d/%m/%Y %H:%M:%S") }}</td>
      <td>{{ log.user.username if log.user else "-" }}</td>
      <td>{{ log.action }}</td>
      <td>{{ log.table_name }}</td>
      <td>{{ log.record_id }}</td>
      <td>{{ log.details }}</td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="text-muted">ไม่มีข้อมูล</td></tr>
    {% endfor %}
  </tbody>
</table>

{% if pagination.pages > 1 %}
<nav>
  <ul class="pagination">
    {% for p in range(1, pagination.pages + 1) %}
    <li class="page-item {% if p == pagination.page %}active{% endif %}">
      <a class="page-link" href="{{ url_for('admin.logs', page=p) }}">{{ p }}</a>
    </li>
    {% endfor %}
  </ul>
</nav>
{% endif %}
{% endblock %}
</file>

<file path="templates/admin_orders.html">
{% extends "base.html" %}
{% block title %}จัดการคำสั่งซื้อ{% endblock %}
{% block content %}
<h3 class="mb-4">จัดการคำสั่งซื้อ</h3>

<div class="mb-3">
  <a href="{{ url_for('admin.orders') }}" class="btn btn-sm {{ 'btn-primary' if not status else 'btn-outline-primary' }}">ทั้งหมด</a>
  {% for s, label in [("awaiting_payment", "รอตรวจสลิป"), ("paid", "ชำระแล้ว"), ("shipped", "จัดส่งแล้ว"), ("completed", "สำเร็จ")] %}
  <a href="{{ url_for('admin.orders', status=s) }}" class="btn btn-sm {{ 'btn-primary' if status == s else 'btn-outline-primary' }}">{{ label }}</a>
  {% endfor %}
</div>

<table class="table align-middle">
  <thead><tr><th>เลขที่</th><th>ลูกค้า</th><th>ยอด</th><th>สลิป</th><th>สถานะ</th><th>จัดการ</th></tr></thead>
  <tbody>
    {% for order in orders %}
    <tr>
      <td>#{{ order.id }}</td>
      <td>{{ order.customer.username }}</td>
      <td>฿{{ "%.2f"|format(order.total_amount) }}</td>
      <td>
        {% if order.slip_filename %}
        <a href="{{ order.slip_filename | slip_url }}" target="_blank">ดูสลิป</a>
        {% else %}-{% endif %}
      </td>
      <td>{{ order.STATUS_LABELS.get(order.status, order.status) }}</td>
      <td class="d-flex gap-1">
        {% if order.status == "awaiting_payment" %}
        <form method="post" action="{{ url_for('admin.confirm_payment', order_id=order.id) }}">
          <button class="btn btn-sm btn-success">ยืนยันการชำระเงิน</button>
        </form>
        {% else %}
        <form method="post" action="{{ url_for('admin.update_status', order_id=order.id) }}" class="d-flex gap-1">
          <select name="status" class="form-select form-select-sm" style="width:auto">
            <option value="paid" {% if order.status == "paid" %}selected{% endif %}>ชำระเงินแล้ว</option>
            <option value="shipped" {% if order.status == "shipped" %}selected{% endif %}>จัดส่งแล้ว</option>
            <option value="completed" {% if order.status == "completed" %}selected{% endif %}>สำเร็จ</option>
            <option value="cancelled" {% if order.status == "cancelled" %}selected{% endif %}>ยกเลิก</option>
          </select>
          <button class="btn btn-sm btn-outline-primary">อัปเดต</button>
        </form>
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="text-muted">ไม่มีคำสั่งซื้อ</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
</file>

<file path="templates/admin_pending.html">
{% extends "base.html" %}
{% block title %}อนุมัติผลงาน{% endblock %}
{% block content %}
<h3 class="mb-4">ผลงานรออนุมัติ</h3>

<div class="row row-cols-1 row-cols-md-3 g-4">
  {% for art in artworks %}
  <div class="col">
    <div class="card h-100">
